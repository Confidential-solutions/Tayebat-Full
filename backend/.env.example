# Backend Environment Variables
# Copy: cp .env.example .env
# Never commit .env — it is gitignored.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string (REQUIRED — no SQLite fallback)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/tayebat

# JWT (REQUIRED)
# Use a long random string (>= 32 chars). Known placeholders are rejected in production.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# CORS — frontend origin
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
